{
  "name": "vaga-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensão do Chrome que compara seu currículo com a vaga aberta, 100% no navegador.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "npm run build:site && npm run build:ext",
    "build:site": "vite build --config vite.site.config.ts",
    "build:ext": "vite build --config vite.ext.config.ts",
    "zip": "node scripts/zip-extension.mjs",
    "preview": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "pdfjs-dist": "^6.3.289"
  }
}
